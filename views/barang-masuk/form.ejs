
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | StockFlow</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            background: #f4f6fa;
            font-family: Arial, sans-serif;
            color: #263449;
        }

        .container {
            max-width: 650px;
            margin: 30px auto;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 12px #00000008;
        }

        h1 {
            margin-top: 0;
        }

        .subtitle {
            color: #7b8798;
            margin-bottom: 25px;
        }

        label {
            display: block;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 8px;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #dce2ea;
            border-radius: 7px;
            margin-bottom: 20px;
            font-size: 14px;
            font-family: inherit;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #2563eb;
        }

        textarea {
            resize: vertical;
        }

        .btn {
            display: inline-block;
            padding: 12px 18px;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }

        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .btn-secondary {
            background: #e2e8f0;
            color: #334155;
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .alert {
            padding: 12px;
            background: #fee2e2;
            color: #991b1b;
            border-radius: 7px;
            margin-bottom: 18px;
        }

        .stock-info {
            color: #64748b;
            font-size: 13px;
            margin-top: -12px;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

    <div class="container">
        <div class="card">

            <h1><%= title %></h1>

            <p class="subtitle">
                Lengkapi informasi transaksi barang masuk.
            </p>

            <% if (error) { %>
                <div class="alert">
                    <%= error %>
                </div>
            <% } %>

            <form action="<%= action %>" method="POST">

                <label for="barang_id">Pilih Barang</label>

                <select name="barang_id" id="barang_id" required>
                    <option value="">-- Pilih Barang --</option>

                    <% barang.forEach(item => { %>
                        <option
                            value="<%= item.id %>"
                            <%= Number(data.barang_id) === Number(item.id) ? 'selected' : '' %>>

                            <%= item.kode %> - <%= item.nama %>
                            (Stok: <%= item.stok %> <%= item.satuan %>)

                        </option>
                    <% }) %>
                </select>

                <% if (barang.length === 0) { %>
                    <p class="stock-info">
                        Belum ada data barang. Tambahkan barang terlebih dahulu.
                    </p>
                <% } %>

                <label for="tanggal">Tanggal Transaksi</label>

                <input
                    type="date"
                    id="tanggal"
                    name="tanggal"
                    value="<%= data.tanggal ? new Date(data.tanggal).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10) %>"
                    required>

                <label for="jumlah">Jumlah Barang Masuk</label>

                <input
                    type="number"
                    id="jumlah"
                    name="jumlah"
                    min="1"
                    step="1"
                    placeholder="Contoh: 50"
                    value="<%= data.jumlah || '' %>"
                    required>

                <label for="keterangan">Keterangan</label>

                <textarea
                    id="keterangan"
                    name="keterangan"
                    rows="4"
                    maxlength="255"
                    placeholder="Contoh: Pembelian stok dari supplier"><%= data.keterangan || '' %></textarea>

                <div class="actions">

                    <button
                        type="submit"
                        class="btn btn-primary"
                        <%= barang.length === 0 ? 'disabled' : '' %>>

                        Simpan Transaksi
                    </button>

                    <a href="/barang-masuk" class="btn btn-secondary">
                        Batal
                    </a>

                </div>

            </form>

        </div>
    </div>

</body>
</html>
